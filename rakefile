# Kommandon för att köra appen:
# rake        # startar appen (seedar databasen automatiskt om den saknas)
# rake seed   # återställer databasen från db/seeder.rb
# rake kill   # stänger av webbservern på port 9292

require_relative 'config'

task :seed do
  require_relative './db/seeder'
end

task default: [] do
  unless File.exist?(DB_PATH)
    require_relative './db/seeder'
  end
  puts "🚀 Startar på http://localhost:9292"
  sh 'lsof -ti:9292 | xargs kill -9 > /dev/null 2>&1 || true'
  sh 'bundle exec rackup --host 0.0.0.0'
end

task :kill do
  sh 'lsof -ti:9292 | xargs kill -9 > /dev/null 2>&1 || true'
end
